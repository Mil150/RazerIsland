<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <RootNamespace>RazerIsland</RootNamespace>
    <AssemblyName>RazerIsland</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>

    <Version>0.2.3</Version>
    <Product>Razer Island</Product>
    <Description>Заряд Razer, годинник, погода, розклад і мікрофон Discord</Description>
    <Copyright>© 2026 Mil150</Copyright>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF і WinForms разом: імена на кшталт Application/Brush/Color конфліктують -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\app.ico" />
    <!-- Corsair iCUE SDK v4.0.84 (redist з github.com/CorsairOfficial/cue-sdk) -->
    <None Include="Native\iCUESDK.x64_2019.dll" Link="iCUESDK.x64_2019.dll" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.Management" Version="10.0.0" />
  </ItemGroup>

</Project>
