<Window x:Class="RazerIsland.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:l="clr-namespace:RazerIsland.UI"
        Title="Razer Island — налаштування" Width="760" Height="560" MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="#141619" FontFamily="Segoe UI" FontSize="13"
        UseLayoutRounding="True">
  <Window.Resources>
    <Style TargetType="TextBlock">
      <Setter Property="Foreground" Value="#D6D9DE"/>
      <Setter Property="TextWrapping" Value="Wrap"/>
    </Style>
    <Style TargetType="Hyperlink">
      <Setter Property="Foreground" Value="#6EA8FF"/>
    </Style>
    <Style TargetType="Button">
      <Setter Property="Foreground" Value="#F2F3F5"/>
      <Setter Property="Background" Value="#2A2D33"/>
      <Setter Property="Padding" Value="16,8"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Button">
            <Border x:Name="b" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
              <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="Opacity" Value="0.85"/></Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.35"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#44D62C"/>
      <Setter Property="Foreground" Value="#0B0C0E"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="Nav" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="Transparent"/>
      <Setter Property="HorizontalContentAlignment" Value="Left"/>
      <Setter Property="Padding" Value="12,9"/>
      <Setter Property="Margin" Value="0,1"/>
    </Style>
    <!-- поля вводу: заокруглена рамка, зелена при фокусі -->
    <ControlTemplate x:Key="InputTemplate" TargetType="Control">
      <Border x:Name="b" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8">
        <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" Focusable="False"/>
      </Border>
      <ControlTemplate.Triggers>
        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#555A63"/></Trigger>
        <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="b" Property="BorderBrush" Value="#44D62C"/></Trigger>
        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="b" Property="Opacity" Value="0.4"/></Trigger>
      </ControlTemplate.Triggers>
    </ControlTemplate>
    <Style TargetType="TextBox">
      <Setter Property="Background" Value="#1E2126"/>
      <Setter Property="Foreground" Value="#F2F3F5"/>
      <Setter Property="CaretBrush" Value="#F2F3F5"/>
      <Setter Property="SelectionBrush" Value="#44D62C"/>
      <Setter Property="BorderBrush" Value="#33FFFFFF"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Template" Value="{StaticResource InputTemplate}"/>
    </Style>
    <Style TargetType="PasswordBox">
      <Setter Property="Background" Value="#1E2126"/>
      <Setter Property="Foreground" Value="#F2F3F5"/>
      <Setter Property="CaretBrush" Value="#F2F3F5"/>
      <Setter Property="SelectionBrush" Value="#44D62C"/>
      <Setter Property="BorderBrush" Value="#33FFFFFF"/>
      <Setter Property="Padding" Value="8,6"/>
      <Setter Property="Template" Value="{StaticResource InputTemplate}"/>
    </Style>
    <!-- галочка: заокруглений квадрат, зелений із позначкою, коли ввімкнено -->
    <Style TargetType="CheckBox">
      <Setter Property="Foreground" Value="#E6E8EB"/>
      <Setter Property="Margin" Value="0,5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="CheckBox">
            <StackPanel x:Name="root" Orientation="Horizontal" Background="Transparent">
              <Border x:Name="box" Width="18" Height="18" CornerRadius="5" BorderThickness="1.5" BorderBrush="#555A63" Background="#1E2126" VerticalAlignment="Center">
                <Path x:Name="mark" Data="M 3.5,8.5 L 7,12 L 13,5" Stroke="#0B0C0E" StrokeThickness="2.2"
                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
              </Border>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="#7BE866"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="box" Property="Background" Value="#44D62C"/>
                <Setter TargetName="box" Property="BorderBrush" Value="#44D62C"/>
                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="root" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- перемикач: коло із зеленою крапкою, коли вибрано -->
    <Style TargetType="RadioButton">
      <Setter Property="Foreground" Value="#E6E8EB"/>
      <Setter Property="Margin" Value="0,5"/>
      <Setter Property="Cursor" Value="Hand"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RadioButton">
            <StackPanel x:Name="root" Orientation="Horizontal" Background="Transparent">
              <Grid Width="18" Height="18" VerticalAlignment="Center">
                <Ellipse x:Name="ring" Stroke="#555A63" StrokeThickness="1.5" Fill="#1E2126"/>
                <Ellipse x:Name="dot" Width="8" Height="8" Fill="#44D62C" Visibility="Collapsed"/>
              </Grid>
              <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" RecognizesAccessKey="True"/>
            </StackPanel>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ring" Property="Stroke" Value="#7BE866"/></Trigger>
              <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="ring" Property="Stroke" Value="#44D62C"/>
                <Setter TargetName="dot" Property="Visibility" Value="Visible"/>
              </Trigger>
              <Trigger Property="IsEnabled" Value="False"><Setter TargetName="root" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style x:Key="H1" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#F2F3F5"/>
      <Setter Property="FontSize" Value="22"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,0,0,10"/>
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
      <Setter Property="Foreground" Value="#8A8F98"/>
      <Setter Property="FontSize" Value="11"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Margin" Value="0,16,0,4"/>
    </Style>
    <Style x:Key="Box" TargetType="Border">
      <Setter Property="Background" Value="#1B1E23"/>
      <Setter Property="CornerRadius" Value="10"/>
      <Setter Property="Padding" Value="14,12"/>
      <Setter Property="Margin" Value="0,6,0,0"/>
    </Style>
    <!-- повзунок: темна доріжка, зелена заповнена частина, світлий кружечок -->
    <Style x:Key="SliderPart" TargetType="RepeatButton">
      <Setter Property="OverridesDefaultStyle" Value="True"/>
      <Setter Property="Focusable" Value="False"/>
      <Setter Property="IsTabStop" Value="False"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="RepeatButton">
            <Border Background="Transparent">
              <Border Height="4" CornerRadius="2" Background="{TemplateBinding Background}" VerticalAlignment="Center"/>
            </Border>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="Slider">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Slider">
            <Grid Height="22" Background="Transparent">
              <Border Height="4" CornerRadius="2" Background="#2A2D33" VerticalAlignment="Center"/>
              <Track x:Name="PART_Track">
                <Track.DecreaseRepeatButton>
                  <RepeatButton Style="{StaticResource SliderPart}" Background="#44D62C" Command="Slider.DecreaseLarge"/>
                </Track.DecreaseRepeatButton>
                <Track.IncreaseRepeatButton>
                  <RepeatButton Style="{StaticResource SliderPart}" Background="Transparent" Command="Slider.IncreaseLarge"/>
                </Track.IncreaseRepeatButton>
                <Track.Thumb>
                  <Thumb>
                    <Thumb.Template>
                      <ControlTemplate TargetType="Thumb">
                        <Ellipse x:Name="k" Width="16" Height="16" Fill="#F2F3F5"/>
                        <ControlTemplate.Triggers>
                          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="k" Property="Fill" Value="#7BE866"/></Trigger>
                          <Trigger Property="IsDragging" Value="True"><Setter TargetName="k" Property="Fill" Value="#44D62C"/></Trigger>
                        </ControlTemplate.Triggers>
                      </ControlTemplate>
                    </Thumb.Template>
                  </Thumb>
                </Track.Thumb>
              </Track>
            </Grid>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <!-- тонка темна смуга прокрутки замість стандартної світлої -->
    <Style TargetType="Thumb" x:Key="ScrollThumb">
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="Thumb">
            <Border x:Name="t" Background="#3A3E46" CornerRadius="3"/>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="t" Property="Background" Value="#555A63"/></Trigger>
              <Trigger Property="IsDragging" Value="True"><Setter TargetName="t" Property="Background" Value="#6B7078"/></Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
    </Style>
    <Style TargetType="ScrollBar">
      <Setter Property="Width" Value="6"/>
      <Setter Property="MinWidth" Value="6"/>
      <Setter Property="Template">
        <Setter.Value>
          <ControlTemplate TargetType="ScrollBar">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
            </Track>
          </ControlTemplate>
        </Setter.Value>
      </Setter>
      <Style.Triggers>
        <Trigger Property="Orientation" Value="Horizontal">
          <Setter Property="Width" Value="Auto"/>
          <Setter Property="MinWidth" Value="0"/>
          <Setter Property="Height" Value="6"/>
          <Setter Property="MinHeight" Value="6"/>
          <Setter Property="Template">
            <Setter.Value>
              <ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track">
                  <Track.Thumb><Thumb Style="{StaticResource ScrollThumb}"/></Track.Thumb>
                </Track>
              </ControlTemplate>
            </Setter.Value>
          </Setter>
        </Trigger>
      </Style.Triggers>
    </Style>
  </Window.Resources>

  <Grid>
    <Grid.ColumnDefinitions>
      <ColumnDefinition Width="Auto"/>
      <ColumnDefinition Width="*"/>
    </Grid.ColumnDefinitions>

    <!-- бічне меню (режим налаштувань) -->
    <Border x:Name="Sidebar" Grid.Column="0" Width="190" Background="#0F1114" Padding="12,16">
      <StackPanel>
        <StackPanel Orientation="Horizontal" Margin="6,0,0,18">
          <Ellipse Width="9" Height="9" Fill="#44D62C" VerticalAlignment="Center" Margin="0,0,8,0"/>
          <TextBlock Text="Razer Island" Foreground="#F2F3F5" FontSize="15" FontWeight="SemiBold"/>
        </StackPanel>
        <TextBlock x:Name="VersionText" Foreground="#6B7078" FontSize="11" Margin="23,-14,0,18"/>
        <Button x:Name="N1" Style="{StaticResource Nav}" Tag="1" Content="{l:Tr 'Батарея', 'Battery'}"/>
        <Button x:Name="N2" Style="{StaticResource Nav}" Tag="2" Content="{l:Tr 'Вигляд', 'Appearance'}"/>
        <Button x:Name="N3" Style="{StaticResource Nav}" Tag="3" Content="{l:Tr 'Погода', 'Weather'}"/>
        <Button x:Name="N4" Style="{StaticResource Nav}" Tag="4" Content="{l:Tr 'Календар', 'Calendar'}"/>
        <Button x:Name="N5" Style="{StaticResource Nav}" Tag="5" Content="{l:Tr 'Мікрофон Discord', 'Discord microphone'}"/>
        <Button x:Name="N6" Style="{StaticResource Nav}" Tag="6" Content="{l:Tr 'Система', 'System'}"/>
        <Button x:Name="NWizard" Style="{StaticResource Nav}" Margin="0,18,0,0" Foreground="#8A8F98" Content="{l:Tr 'Пройти майстер ще раз', 'Run setup wizard again'}"/>
      </StackPanel>
    </Border>

    <Grid Grid.Column="1" Margin="28,22,28,18">
      <Grid.RowDefinitions>
        <RowDefinition Height="Auto"/>
        <RowDefinition Height="*"/>
        <RowDefinition Height="Auto"/>
      </Grid.RowDefinitions>

      <StackPanel Grid.Row="0">
        <TextBlock x:Name="StepText" Foreground="#44D62C" FontSize="11" FontWeight="SemiBold" Margin="0,0,0,4"/>
        <Border x:Name="StepBar" Height="3" Background="#22FFFFFF" CornerRadius="1.5" Margin="0,0,0,14">
          <Border x:Name="StepFill" Height="3" Background="#44D62C" CornerRadius="1.5" HorizontalAlignment="Left"/>
        </Border>
      </StackPanel>

      <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
        <Grid x:Name="Pages" Margin="0,0,16,0">

          <!-- 0: Вітання -->
          <StackPanel x:Name="P0">
            <TextBlock Style="{StaticResource H2}" Text="МОВА · LANGUAGE" Margin="0,0,0,4"/>
            <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
              <RadioButton x:Name="RbLangUk0" GroupName="lang0" Content="Українська" Margin="0,5,24,5"/>
              <RadioButton x:Name="RbLangEn0" GroupName="lang0" Content="English"/>
            </StackPanel>
            <TextBlock Style="{StaticResource H1}" Text="{l:Tr 'Вітаю в Razer Island', 'Welcome to Razer Island'}"/>
            <TextBlock Text="{l:Tr 'Це віджет-острівець угорі екрана, як Dynamic Island в айфоні. Він показує:', 'A widget island at the top of the screen, like the Dynamic Island on an iPhone. It shows:'}"/>
            <Border Style="{StaticResource Box}">
              <StackPanel>
                <TextBlock LineHeight="22" Visibility="{l:Only uk}">
                  • заряд бездротових пристроїв — Razer, Bluetooth та інших (і в треї біля годинника);<LineBreak/>
                  • годинник, дату й погоду;<LineBreak/>
                  • твій розклад із Google Календаря;<LineBreak/>
                  • стан мікрофона в Discord — вимкнений мікрофон видно поверх усіх вікон.
                </TextBlock>
                <TextBlock LineHeight="22" Visibility="{l:Only en}">
                  • battery of your wireless devices — Razer, Bluetooth and more (also in the tray next to the clock);<LineBreak/>
                  • the time, date and weather;<LineBreak/>
                  • your schedule from Google Calendar;<LineBreak/>
                  • your Discord microphone state — a muted mic is shown on top of all windows.
                </TextBlock>
              </StackPanel>
            </Border>
            <TextBlock Margin="0,14,0,0" Text="{l:Tr 'Налаштування займе 2–3 хвилини. Будь-який крок можна пропустити й повернутися до нього пізніше: права кнопка на іконці в треї → «Налаштування».', 'Setup takes 2–3 minutes. You can skip any step and come back later: right-click the tray icon → Settings.'}"/>
          </StackPanel>

          <!-- 1: Батарея -->
          <StackPanel x:Name="P1">
            <TextBlock Style="{StaticResource H1}" Text="{l:Tr 'Батарея Razer', 'Razer battery'}"/>
            <TextBlock Text="{l:Tr 'Заряд береться з програми Razer Synapse 4 — вона має бути встановлена й запущена (зазвичай вона сама стартує з Windows).', 'Battery levels come from Razer Synapse 4 — it must be installed and running (it usually starts with Windows).'}"/>
            <TextBlock Style="{StaticResource H2}" Text="{l:Tr 'ЗНАЙДЕНІ ПРИСТРОЇ', 'DEVICES FOUND'}"/>
            <Border Style="{StaticResource Box}">
              <TextBlock x:Name="BatStatus" LineHeight="22"/>
            </Border>
            <TextBlock Margin="0,8,0,0" Foreground="#8A8F98" FontSize="12" Text="{l:Tr 'Також показуються Bluetooth-пристрої та бездротові Logitech, SteelSeries (гарнітури Arctis) і Corsair (потрібен запущений iCUE). Підтримка Logitech, SteelSeries і Corsair — експериментальна.', 'Bluetooth devices and wireless Logitech, SteelSeries (Arctis headsets) and Corsair (iCUE must be running) are shown too. Logitech, SteelSeries and Corsair support is experimental.'}"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button x:Name="BtnBatRefresh" Content="{l:Tr 'Перевірити знову', 'Check again'}"/>
            </StackPanel>
            <TextBlock Margin="0,14,0,0" Foreground="#8A8F98" FontSize="12" Visibility="{l:Only uk}">
              Немає Synapse? Завантаж його з сайту Razer:
              <Hyperlink NavigateUri="https://www.razer.com/synapse-4">razer.com/synapse-4</Hyperlink>.
              Заряд мишки оновлюється приблизно раз на 1–2 хвилини, навушників — рідше: так часто його записує сам Synapse.
            </TextBlock>
            <TextBlock Margin="0,14,0,0" Foreground="#8A8F98" FontSize="12" Visibility="{l:Only en}">
              No Synapse? Download it from Razer:
              <Hyperlink NavigateUri="https://www.razer.com/synapse-4">razer.com/synapse-4</Hyperlink>.
              The mouse level updates about every 1–2 minutes and the headset less often — that is how often Synapse itself records it.
            </TextBlock>
          </StackPanel>

          <!-- 2: Вигляд -->
          <StackPanel x:Name="P2">
            <TextBlock Style="{StaticResource H1}" Text="{l:Tr 'Вигляд', 'Appearance'}"/>
            <TextBlock Style="{StaticResource H2}" Text="МОВА · LANGUAGE" Margin="0,0,0,4"/>
            <RadioButton x:Name="RbLangUk" GroupName="lang" Content="Українська"/>
            <RadioButton x:Name="RbLangEn" GroupName="lang" Content="English"/>
            <TextBlock Style="{StaticResource H2}" Text="{l:Tr 'ФОРМА', 'SHAPE'}"/>
            <RadioButton x:Name="RbIsland" GroupName="mode" Content="{l:Tr 'Острівець зверху по центру — розкривається, коли наводиш мишку', 'Island at the top centre — expands when you hover over it'}"/>
            <RadioButton x:Name="RbCard" GroupName="mode" Content="{l:Tr 'Плаваюча картка — завжди розкрита, можна перетягувати', 'Floating card — always expanded, can be dragged'}"/>
            <TextBlock Style="{StaticResource H2}" Text="{l:Tr 'ПОВЕДІНКА', 'BEHAVIOUR'}"/>
            <CheckBox x:Name="CbTop" Content="{l:Tr 'Завжди поверх усіх вікон', 'Always on top'}"/>
            <CheckBox x:Name="CbPin" Content="{l:Tr 'Закріпити картку на місці (щоб випадково не перетягнути)', 'Lock the card in place (so it is not dragged by accident)'}"/>
            <TextBlock Style="{StaticResource H2}" Text="{l:Tr 'НЕПРОЗОРІСТЬ ФОНУ', 'BACKGROUND OPACITY'}"/>
            <Grid>
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/></Grid.ColumnDefinitions>
              <Slider x:Name="SlOpacity" Minimum="40" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" VerticalAlignment="Center"/>
              <TextBlock x:Name="LblOpacity" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="#F2F3F5"/>
            </Grid>
            <TextBlock Style="{StaticResource H2}" Text="{l:Tr 'ІКОНКИ В ТРЕЇ', 'TRAY ICONS'}"/>
            <RadioButton x:Name="RbTrayIcon" GroupName="tray" Content="{l:Tr 'Значок пристрою + смужка заряду', 'Device icon + charge bar'}"/>
            <RadioButton x:Name="RbTrayNum" GroupName="tray" Content="{l:Tr 'Відсоток заряду цифрами + смужка заряду', 'Battery percentage + charge bar'}"/>
            <TextBlock Margin="0,8,0,0" Foreground="#8A8F98" FontSize="12" Text="{l:Tr 'Якщо іконок не видно біля годинника — Windows сховала їх під стрілочку ^. Перетягни їх на панель або увімкни в Параметри → Персоналізація → Панель завдань → Інші значки.', 'If the icons are not next to the clock, Windows has hidden them under the ^ arrow. Drag them onto the taskbar or turn them on in Settings → Personalisation → Taskbar → Other system tray icons.'}"/>
          </StackPanel>

          <!-- 3: Погода -->
          <StackPanel x:Name="P3">
            <TextBlock Style="{StaticResource H1}" Text="{l:Tr 'Погода', 'Weather'}"/>
            <TextBlock Text="{l:Tr 'Введи своє місто — погода оновлюється кожні 15 хвилин (дані open-meteo.com, без реєстрації).', 'Enter your city — the weather updates every 15 minutes (data from open-meteo.com, no sign-up).'}"/>
            <Grid Margin="0,14,0,0">
              <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
              <TextBox x:Name="TbCity"/>
              <Button x:Name="BtnCity" Grid.Column="1" Margin="8,0,0,0" Content="{l:Tr 'Знайти', 'Search'}"/>
            </Grid>
            <TextBlock x:Name="CityStatus" Margin="0,10,0,0" Foreground="#8A8F98"/>
          </StackPanel>

          <!-- 4: Календар -->
          <StackPanel x:Name="P4">
            <TextBlock Style="{StaticResource H1}" Text="{l:Tr 'Google Календар', 'Google Calendar'}"/>
            <TextBlock Text="{l:Tr 'Щоб бачити розклад, віджету потрібне секретне посилання на календар (без входу в акаунт):', 'To show your schedule, the widget needs your calendar’s secret link (no sign-in):'}"/>
            <Border Style="{StaticResource Box}">
              <StackPanel>
                <TextBlock LineHeight="22" Visibility="{l:Only uk}">
                  1. Відкрий <Hyperlink NavigateUri="https://calendar.google.com/calendar/r/settings">налаштування Google Календаря</Hyperlink>.<LineBreak/>
                  2. Зліва в розділі «Налаштування моїх календарів» вибери свій календар.<LineBreak/>
                  3. Прокрути до «Інтеграція календаря» і скопіюй «Секретна адреса у форматі iCal».<LineBreak/>
                  4. Встав її нижче. Можна кілька календарів — по одному посиланню в рядку.
                </TextBlock>
                <TextBlock LineHeight="22" Visibility="{l:Only en}">
                  1. Open <Hyperlink NavigateUri="https://calendar.google.com/calendar/r/settings">Google Calendar settings</Hyperlink>.<LineBreak/>
                  2. On the left, under “Settings for my calendars”, choose your calendar.<LineBreak/>
                  3. Scroll to “Integrate calendar” and copy “Secret address in iCal format”.<LineBreak/>
                  4. Paste it below. You can add several calendars — one link per line.
                </TextBlock>
              </StackPanel>
            </Border>
            <TextBox x:Name="TbCal" Margin="0,12,0,0" AcceptsReturn="True" Height="74" TextWrapping="NoWrap" VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="12"/>
            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
              <Button x:Name="BtnCalTest" Content="{l:Tr 'Зберегти й перевірити', 'Save and test'}"/>
            </StackPanel>
            <TextBlock x:Name="CalStatus" Margin="0,10,0,0" Foreground="#8A8F98"/>
            <TextBlock Margin="0,10,0,0" Foreground="#FFB347" FontSize="12" Text="{l:Tr 'Нікому не показуй це посилання — за ним видно весь календар. Воно зберігається тільки на цьому комп’ютері.', 'Do not share this link — anyone with it can see your whole calendar. It is stored only on this computer.'}"/>
          </StackPanel>

          <!-- 5: Discord -->
          <StackPanel x:Name="P5">
            <TextBlock Style="{StaticResource H1}" Text="{l:Tr 'Мікрофон у Discord', 'Discord microphone'}"/>
            <TextBlock Text="{l:Tr 'Коли вимикаєш мікрофон у Discord, острівець показує це поверх усіх вікон. Discord дозволяє це лише через твій власний «застосунок» — його створення займає 2 хвилини:', 'When you mute your mic in Discord, the island shows it on top of all windows. Discord only allows this through your own “application” — creating one takes 2 minutes:'}"/>
            <Border Style="{StaticResource Box}">
              <StackPanel>
                <TextBlock LineHeight="22" Visibility="{l:Only uk}">
                  1. Відкрий <Hyperlink NavigateUri="https://discord.com/developers/applications">Discord Developer Portal</Hyperlink> → «New Application» → будь-яка назва → «Create».<LineBreak/>
                  2. Зліва відкрий «OAuth2» і скопіюй «Client ID».<LineBreak/>
                  3. Там само натисни «Reset Secret» і скопіюй «Client Secret».<LineBreak/>
                  4. У «Redirects» натисни «Add Redirect», впиши <Run Foreground="#F2F3F5" FontFamily="Consolas">http://localhost</Run> і натисни «Save Changes».<LineBreak/>
                  5. Встав Client ID і Client Secret нижче й натисни «Підключити». У Discord з'явиться вікно — натисни «Авторизувати».
                </TextBlock>
                <TextBlock LineHeight="22" Visibility="{l:Only en}">
                  1. Open the <Hyperlink NavigateUri="https://discord.com/developers/applications">Discord Developer Portal</Hyperlink> → “New Application” → any name → “Create”.<LineBreak/>
                  2. On the left, open “OAuth2” and copy the “Client ID”.<LineBreak/>
                  3. On the same page, click “Reset Secret” and copy the “Client Secret”.<LineBreak/>
                  4. Under “Redirects”, click “Add Redirect”, enter <Run Foreground="#F2F3F5" FontFamily="Consolas">http://localhost</Run> and click “Save Changes”.<LineBreak/>
                  5. Paste the Client ID and Client Secret below and click “Connect”. A window appears in Discord — click “Authorize”.
                </TextBlock>
              </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource H2}" Text="CLIENT ID"/>
            <TextBox x:Name="TbDiscordId" FontFamily="Consolas"/>
            <TextBlock Style="{StaticResource H2}" Text="CLIENT SECRET"/>
            <PasswordBox x:Name="PbDiscordSecret"/>
            <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
              <Button x:Name="BtnDiscord" Style="{StaticResource Primary}" Content="{l:Tr 'Підключити', 'Connect'}"/>
              <Button x:Name="BtnDiscordOff" Margin="8,0,0,0" Content="{l:Tr 'Відключити', 'Disconnect'}"/>
            </StackPanel>
            <TextBlock x:Name="DiscordStatus" Margin="0,10,0,0" Foreground="#8A8F98"/>
          </StackPanel>

          <!-- 6: Система -->
          <StackPanel x:Name="P6">
            <TextBlock Style="{StaticResource H1}" Text="{l:Tr 'Система', 'System'}"/>
            <CheckBox x:Name="CbAuto" Content="{l:Tr 'Запускати разом з Windows', 'Start with Windows'}"/>
            <CheckBox x:Name="CbDesktop" Content="{l:Tr 'Ярлик «Razer Island» на робочому столі', 'Razer Island shortcut on the desktop'}"/>
            <Border Style="{StaticResource Box}" Margin="0,14,0,0">
              <TextBlock x:Name="SysInfo" LineHeight="22" Foreground="#A9ADB5" FontSize="12"/>
            </Border>
          </StackPanel>

          <!-- 7: Готово -->
          <StackPanel x:Name="P7">
            <TextBlock Style="{StaticResource H1}" Text="{l:Tr 'Готово!', 'All set!'}"/>
            <Border Style="{StaticResource Box}">
              <StackPanel>
                <TextBlock LineHeight="22" Visibility="{l:Only uk}">
                  • Наведи мишку на острівець угорі екрана — він розкриється.<LineBreak/>
                  • Права кнопка на острівці або на іконці в треї → «Налаштування», щоб щось змінити.<LineBreak/>
                  • Razer Island тепер є в меню «Пуск» — його можна закріпити на початковому екрані.
                </TextBlock>
                <TextBlock LineHeight="22" Visibility="{l:Only en}">
                  • Hover over the island at the top of the screen to expand it.<LineBreak/>
                  • Right-click the island or the tray icon → Settings to change anything.<LineBreak/>
                  • Razer Island is now in the Start menu — you can pin it to Start.
                </TextBlock>
              </StackPanel>
            </Border>
          </StackPanel>
        </Grid>
      </ScrollViewer>

      <Grid Grid.Row="2" Margin="0,16,0,0">
        <Button x:Name="BtnSkip" HorizontalAlignment="Left" Background="Transparent" Foreground="#8A8F98" Content="{l:Tr 'Пропустити налаштування', 'Skip setup'}"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button x:Name="BtnBack" Content="{l:Tr 'Назад', 'Back'}"/>
          <Button x:Name="BtnNext" Style="{StaticResource Primary}" Margin="8,0,0,0" Content="{l:Tr 'Далі', 'Next'}"/>
          <Button x:Name="BtnClose" Style="{StaticResource Primary}" Margin="8,0,0,0" Content="{l:Tr 'Закрити', 'Close'}"/>
        </StackPanel>
      </Grid>
    </Grid>
  </Grid>
</Window>
